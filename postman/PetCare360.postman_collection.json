            "body": {
              "mode": "raw",
              "raw": "{\n  \"idTutor\": {{idTutor}},\n  \"nome\": \"Thor\",\n  \"especie\": \"Canina\",\n  \"raca\": \"Golden Retriever\",\n  \"dtNascimento\": \"2021-06-15\",\n  \"peso\": 32.5,\n  \"sexo\": \"M\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Dados controlados do TC-SYS-03: Thor, Canina, Golden Retriever, 2021-06-15, 32.5 kg, M. Guarda o id em {{idPet}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pick = (b, ...keys) => { for (const k of keys) { if (b && b[k] !== undefined) return b[k]; } return undefined; };",
                  "const isJson = () => (pm.response.headers.get('Content-Type') || '').toLowerCase().includes('application/json');",
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const id = pick(body, 'idPet', 'id', 'IdPet');",
                  "pm.test(\"Resposta traz id numérico do pet\", () => pm.expect(id).to.be.a('number').and.above(0));",
                  "pm.test(\"Nome do pet é Thor\", () => pm.expect(pick(body, 'nome', 'Nome')).to.eql('Thor'));",
                  "if (id) pm.collectionVariables.set('idPet', id);"
                ]
              }
            }
          ]
        }
      ]
