{
  "info": {
    "name": "PetCare 360 - Testes Automatizados (Sprint 4 - Parte B)",
    "description": "Testes automatizados de API do PetCare 360 (.NET 10 + Oracle 19c). Dados controlados extraídos dos casos TC-SYS/TC-CT do Azure Boards. Execute com o Collection Runner ou com Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', Date.now()); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"SLA: tempo de resposta < 2000 ms\", function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5260"
    },
    {
      "key": "tutorNome",
      "value": "Pedro Previtali"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "idTutor",
      "value": ""
    },
    {
      "key": "idPet",
      "value": ""
    },
    {
      "key": "idClinica",
      "value": ""
    },
    {
      "key": "idConsulta",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Smoke: saúde da API e do Oracle",
      "item": [
        {
          "name": "[TC-CT-08] GET /health/ready - Prontidão da API e do Oracle",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Valida a sonda de prontidão (API .NET + conexão Oracle 19c). Rastreia TC-CT-08 e TC-SYS-11."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pick = (b, ...keys) => { for (const k of keys) { if (b && b[k] !== undefined) return b[k]; } return undefined; };",
                  "const isJson = () => (pm.response.headers.get('Content-Type') || '').toLowerCase().includes('application/json');",
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sonda reporta Healthy\", function () {",
                  "  let status;",
                  "  if (isJson()) { status = pm.response.json().status; } else { status = pm.response.text(); }",
                  "  pm.expect(String(status).toLowerCase()).to.include('healthy');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Tutores",
      "item": [
        {
          "name": "[TC-CT-01] POST /api/Tutores - Cadastrar tutor (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Tutores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Tutores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{tutorNome}}\",\n  \"email\": \"pedro.previtali.{{runId}}@petcare360.com.br\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria o tutor de teste e guarda o id em {{idTutor}}. O e-mail usa {{runId}} para evitar conflito entre execuções."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pick = (b, ...keys) => { for (const k of keys) { if (b && b[k] !== undefined) return b[k]; } return undefined; };",
                  "const isJson = () => (pm.response.headers.get('Content-Type') || '').toLowerCase().includes('application/json');",
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type é JSON\", () => pm.expect(isJson()).to.be.true);",
                  "const body = pm.response.json();",
                  "const id = pick(body, 'idTutor', 'id', 'IdTutor');",
                  "pm.test(\"Resposta traz id numérico do tutor\", () => pm.expect(id).to.be.a('number').and.above(0));",
                  "pm.test(\"Nome devolvido confere com o enviado\", () => pm.expect(pick(body, 'nome', 'Nome')).to.eql(pm.collectionVariables.get('tutorNome')));",
                  "if (id) pm.collectionVariables.set('idTutor', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "[TC-CT-02] GET /api/Tutores/{id} - Consultar tutor (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Tutores/{{idTutor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Tutores",
                "{{idTutor}}"
              ]
            },
            "description": "Consulta o tutor criado no passo anterior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pick = (b, ...keys) => { for (const k of keys) { if (b && b[k] !== undefined) return b[k]; } return undefined; };",
                  "const isJson = () => (pm.response.headers.get('Content-Type') || '').toLowerCase().includes('application/json');",
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"idTutor devolvido é o mesmo criado\", () => pm.expect(pick(body, 'idTutor', 'id', 'IdTutor')).to.eql(Number(pm.collectionVariables.get('idTutor'))));",
                  "pm.test(\"Nome do tutor confere\", () => pm.expect(pick(body, 'nome', 'Nome')).to.eql(pm.collectionVariables.get('tutorNome')));"
                ]
              }
            }
          ]
        },
        {
          "name": "[TC-CT-02] GET /api/Tutores/{id} - Tutor inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Tutores/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Tutores",
                "999999"
              ]
            },
            "description": "Teste negativo: ID inexistente não pode devolver dados."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pick = (b, ...keys) => { for (const k of keys) { if (b && b[k] !== undefined) return b[k]; } return undefined; };",
                  "const isJson = () => (pm.response.headers.get('Content-Type') || '').toLowerCase().includes('application/json');",
                  "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
