              "mode": "raw",
              "raw": "{\n  \"idPet\": {{idPet}},\n  \"idClinica\": 99999,\n  \"dataHora\": \"2026-11-03T10:00:00\",\n  \"motivo\": \"Teste de integridade referencial.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Teste negativo de integridade referencial (TC-SYS-05): clínica 99999 não existe e nada pode ser gravado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pick = (b, ...keys) => { for (const k of keys) { if (b && b[k] !== undefined) return b[k]; } return undefined; };",
                  "const isJson = () => (pm.response.headers.get('Content-Type') || '').toLowerCase().includes('application/json');",
                  "pm.test(\"Rejeitada com erro de cliente (400/404/409/422)\", () => pm.expect(pm.response.code).to.be.oneOf([400, 404, 409, 422]));",
                  "pm.test(\"Resposta não cria consulta (sem id de consulta)\", function () {",
                  "  let body = {};",
                  "  try { body = pm.response.json(); } catch (e) {}",
                  "  pm.expect(pick(body, 'idConsulta', 'IdConsulta')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
